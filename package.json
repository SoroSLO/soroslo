{
  "name": "soroslo",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic service-level monitoring for Stellar/Soroban applications.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:structure",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.44.0",
    "@playwright/test": "1.55.0"
  }
}
